# Set DOCKERTEST=1 to auto-spin postgres + minio via Docker (no manual setup needed).
# Containers are named and reused across restarts — data persists.
# To wipe: docker rm -f agentra-dev-postgres agentra-dev-minio
DOCKERTEST=1

# Overridden automatically when DOCKERTEST=1
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agentra?sslmode=disable

# Port the HTTP server listens on (default: 8080)
PORT=8080
CORS_ORIGINS=*
